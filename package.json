{
  "name": "fintrack",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:tax": "vitest run --project tax-engine",
    "test:matrix": "tsx scripts/test-matrix.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "user:create": "tsx scripts/user-create.ts",
    "user:reset-password": "tsx scripts/reset-password.ts",
    "user:set-role": "tsx scripts/set-role.ts",
    "seed:e2e": "tsx scripts/e2e-seed.ts",
    "test:e2e:happy": "playwright test --config playwright.happy-path.config.ts"
  },
  "dependencies": {
    "@fintrack/shared": "workspace:*",
    "@fintrack/tax-engine": "workspace:*",
    "@neondatabase/serverless": "^0.9.4",
    "@prisma/adapter-neon": "^5.19.0",
    "@tanstack/react-query": "^5.56.2",
    "@tanstack/react-query-devtools": "^5.56.2",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.3",
    "next": "14.2.14",
    "next-pwa": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.12.7",
    "resend": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@playwright/test": "^1.47.2",
    "@prisma/client": "^5.19.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.1",
    "dotenv": "^18.0.10",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.14",
    "jsdom": "^25.0.1",
    "prisma": "^5.19.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1",
    "ws": "^8.18.0"
  }
}
