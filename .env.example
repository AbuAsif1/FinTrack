# PostgreSQL connection string (use ?sslmode=require on Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/fintrack"

# Separate database for integration and E2E tests
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/fintrack_test"

# Signs access tokens (HS256 JWT)
JWT_SECRET="change-me-to-a-long-random-string"

# The owner's seed account (created already verified, with ADMIN role)
SEED_USER_EMAIL="owner@example.com"
SEED_USER_PASSWORD="change-me-10-chars"
SEED_USER_NAME="Site Owner"

# Base URL used in email links (no trailing slash)
APP_URL="http://localhost:3000"

# Resend for verification and password-reset emails
RESEND_API_KEY="re_xxxx"
EMAIL_FROM="FinTrack <noreply@example.com>"

# "open" or "closed"; when "closed", registration returns 403
SIGNUP_MODE="open"

# Optional Sentry error tracking; disabled when unset
# SENTRY_DSN="https://xxxx@sentry.io/xxxx"
